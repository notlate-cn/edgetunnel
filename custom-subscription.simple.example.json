{
  "enabled": true,
  "appendServerToName": true,
  "dnsPreset": "default",
  "dns": {
    "fakeIpFilterSource": "rules/custom/fake-ip-filter.list"
  },
  "addProxiesToGroups": true,
  "clash": {
    "useDefaultRuleSets": false,
    "proxyProviders": [
      {
        "name": "NAT鸡",
        "url": "https://example.com/getsub/nat",
        "path": "./proxy-providers/nat.yaml"
      },
      {
        "name": "机场聚合",
        "url": "https://example.com/getsub/collection",
        "path": "./proxy-providers/collection.yaml"
      }
    ],
    "groups": [
      {
        "name": "多国代理",
        "proxies": []
      }
    ],
    "groupProviderUses": {
      "普通代理": [
        "NAT鸡",
        "机场聚合"
      ],
      "多国代理": [
        "NAT鸡",
        "机场聚合"
      ]
    }
  },
  "nodes": {
    "tt": {
      "type": "vless-reality",
      "flag": "🇸🇬",
      "name": "SP-TT",
      "server": "203.0.113.10",
      "port": 443,
      "uuid": "YOUR-TT-UUID",
      "servername": "www.microsoft.com",
      "publicKey": "YOUR-TT-REALITY-PUBLIC-KEY",
      "shortId": "abcd"
    },
    "hd": {
      "type": "vless-reality",
      "flag": "🇺🇸",
      "name": "US-HD",
      "server": "198.51.100.20",
      "port": 443,
      "uuid": "YOUR-HD-UUID",
      "servername": "addons.mozilla.org",
      "clientFingerprint": "firefox",
      "publicKey": "YOUR-HD-REALITY-PUBLIC-KEY",
      "shortId": "",
      "smux": {
        "enabled": false,
        "protocol": "h2mux",
        "padding": false,
        "maxConnections": "8",
        "minStreams": "16",
        "statistic": true,
        "onlyTcp": false
      },
      "brutal": {
        "enabled": false,
        "up": "1000 Mbps",
        "down": "1000 Mbps"
      }
    },
    "static_hd": {
      "type": "socks5-chain",
      "flag": "🇺🇸",
      "name": "US-StaticIP-via-HD",
      "server": "192.0.2.30",
      "port": 22324,
      "username": "YOUR-SOCKS-USERNAME",
      "password": "YOUR-SOCKS-PASSWORD",
      "dialer": "hd"
    },
    "static_tt": {
      "type": "socks5-chain",
      "flag": "🇺🇸",
      "name": "US-StaticIP-via-TT",
      "server": "192.0.2.30",
      "port": 22324,
      "username": "YOUR-SOCKS-USERNAME",
      "password": "YOUR-SOCKS-PASSWORD",
      "dialer": "tt"
    }
  },
  "rules": {
    "sources": [
      { "target": "DIRECT", "source": "rules/custom/direct.list", "noResolve": false },
      { "target": "AI", "source": "rules/custom/ai.list" },
      { "target": "社交支付", "source": "rules/custom/social-payment.list" },
      { "target": "账号服务", "source": "rules/custom/account-services.list" },
      { "target": "多国代理", "source": "rules/custom/multi-country.list" },
      { "target": "普通代理", "source": "rules/custom/proxy.list" },
      { "target": "Apple", "source": "rules/custom/apple.list" }
    ]
  },
  "emoji": {
    "patterns": []
  }
}
